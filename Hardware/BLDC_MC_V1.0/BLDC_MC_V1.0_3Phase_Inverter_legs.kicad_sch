	)
	(text_box "1- Measure the Initial Ringing\n2- Add the \"Shift\" Capacitor - \n	increase the value of C_add until the ringing \n	frequency is exactly half of the original frequency f_new = 0.5 * f_ring).\n3- Calculte the parasitic capacitance C_p = C_add / 3\n4- Calculate Parasitic Inductance L_p -> L_p = 1/((2*pi*f_ring)^2 * C_p)\n5- Determine the Snubber Resistor R_snub -> R_snub = sqrt{L_p/C_p}"
		(exclude_from_sim no)
		(at 176.53 107.95 0)
		(size 92.71 20.32)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "3bee8720-df61-44b7-96b0-010d1f3c3597")
	)
